.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Large/generated runtime outputs from the model pipeline.
# data/processed/ is the local output root: prompts, generations, scored rows.
data/processed/*
!data/processed/.gitkeep

# Local/private survey microdata; pass its path with --ces-dta.
CES25_Common.dta
CES/

# Large external demographic reference table (7.9 MB); re-fetchable from Harvard
# Dataverse (see data/reference/external/README.md). The built name_bank.csv is
# the committed canonical input, so this raw table is not needed to run.
data/reference/external/rosenman_first_nameRaceProbs.tab
/data/
/results/
*.pyc

# Archived superseded outputs (kept on disk, not tracked)
_archive/
